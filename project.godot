; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are meant to be edited
; using the visual interface and not by hand.

config_version=5

[application]

config/name="Battle Stations"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

GameEvents="*res://scripts/game_events.gd"
LevelManager="*res://scripts/level_manager.gd"
BuildManager="*res://scripts/build_manager.gd"
UIManager="*res://scripts/ui_manager.gd"

[rendering]

renderer/rendering_method="gl_compatibility"
